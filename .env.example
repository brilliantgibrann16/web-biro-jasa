# Preview lokal: http://localhost:3100
# Production: ganti dengan origin domain asli, tanpa path tambahan.
NEXT_PUBLIC_SITE_URL=https://domain-produksi-anda.example

# Supabase public config. Publishable key aman dipakai browser karena akses
# database tetap dibatasi grants dan Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Opsional. Isi hanya jika reverse proxy hosting menimpa dan membersihkan header
# ini dari input client. Nilai yang didukung: x-vercel-forwarded-for,
# cf-connecting-ip, x-forwarded-for, atau x-real-ip. Bila kosong, limiter memakai
# satu bucket bersama agar header buatan client tidak dapat membuka bucket baru.
RATE_LIMIT_TRUSTED_PROXY_HEADER=

# Hanya untuk scripts/verify-supabase-security.mjs di mesin pengujian.
# User pengujian harus memiliki app_metadata.role = "admin".
# Jangan deploy dan jangan beri prefix NEXT_PUBLIC_.
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
